//@version=6
strategy("ETHER | Spatial Energy Matrix v3.3 · Volume / FVG Clouds", overlay=true, initial_capital=10000,
     default_qty_type=strategy.percent_of_equity, default_qty_value=10,
     pyramiding=10, commission_type=strategy.commission.percent,
     commission_value=0.04, slippage=1, process_orders_on_close=true,
     calc_on_order_fills=true, backtest_fill_limits_assumption=0, max_lines_count=500, max_boxes_count=300,
     max_labels_count=400, behind_chart=false, explicit_plot_zorder=true)

// Local source contract only. Publication versions are configured in imports.json.
// Publish dependencies first; substitute ACTUAL assigned versions before use.
// GENERATED by tools/build.py; edit master/ and libraries/.

// BEGIN EP_Math/3
// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0.
// © ClassicPotatoChamberXII
// @description ETHER numerical kernel v2. Pure functions, no inputs or orders.
EP_Math_clamp(float value, float low, float high) =>
    math.max(low, math.min(high, value))

EP_Math_safeDiv(float numerator, float denominator, float epsilon = 1e-6) =>
    float protectedDenominator = math.abs(denominator) < epsilon ? (denominator < 0.0 ? -epsilon : epsilon) : denominator
    numerator / protectedDenominator

EP_Math_norm(float value, float scale) =>
    EP_Math_clamp(EP_Math_safeDiv(value, math.max(math.abs(scale), 1e-6)), -1.0, 1.0)

EP_Math_robust(float value, float center, float spread, float clampN) =>
    float z = EP_Math_safeDiv(value - center, spread)
    EP_Math_clamp(z / math.max(math.abs(clampN), 1e-6), -1.0, 1.0)

// Compatibility name retained from the first ETHER prototype.
EP_Math_energyFlux(float value, float center, float spread, float clampN) =>
    EP_Math_robust(value, center, spread, clampN)

EP_Math_kinetic(float value, float scale) =>
    float normalized = math.abs(value) / math.max(math.abs(scale), 1e-6)
    EP_Math_clamp(math.tan(EP_Math_clamp(normalized, 0.0, 1.0) * math.pi / 4.0), 0.0, 1.0)

EP_Math_signedKinetic(float value, float scale) =>
    math.sign(value) * EP_Math_kinetic(value, scale)

EP_Math_weightedMean(float numerator, float denominator) =>
    denominator > 0.0 ? numerator / denominator : 0.0

EP_Math_blend2(float a, float weightA, float b, float weightB) =>
    EP_Math_weightedMean(a * math.max(weightA, 0.0) + b * math.max(weightB, 0.0), math.max(weightA, 0.0) + math.max(weightB, 0.0))

EP_Math_blend3(float a, float weightA, float b, float weightB, float c, float weightC) =>
    float wa = math.max(weightA, 0.0)
    float wb = math.max(weightB, 0.0)
    float wc = math.max(weightC, 0.0)
    EP_Math_weightedMean(a * wa + b * wb + c * wc, wa + wb + wc)

EP_Math_rangeLocation(float value, float low, float high) =>
    EP_Math_clamp(EP_Math_safeDiv(value - low, high - low), 0.0, 1.0)

EP_Math_distanceAtr(float value, float reference, float atr) =>
    EP_Math_safeDiv(value - reference, math.max(math.abs(atr), 1e-6))

EP_Math_qtyFromEquityPct(float equity, float percent, float price, float pointValue) =>
    float unitValue = math.max(price * math.max(pointValue, 1e-6), 1e-6)
    math.max(equity * math.max(percent, 0.0) * 0.01 / unitValue, 0.0)

// Normalized binary Shannon entropy: 0 = ordered, 1 = maximally uncertain.
EP_Math_binaryEntropy(float probability) =>
    float p = EP_Math_clamp(probability, 1e-6, 1.0 - 1e-6)
    -(p * math.log(p) + (1.0 - p) * math.log(1.0 - p)) / math.log(2.0)

// Temporal/temperature attenuation used by the cloud multiplexer.
EP_Math_tempAtten(float entropy, float temperature, float floorValue) =>
    float attenuation = math.exp(-math.max(temperature, 0.0) * EP_Math_clamp(entropy, 0.0, 1.0))
    EP_Math_clamp(attenuation, EP_Math_clamp(floorValue, 0.0, 1.0), 1.0)

EP_Math_agreement(float a, float b, float c) =>
    EP_Math_clamp(1.0 - (math.abs(a - b) + math.abs(b - c) + math.abs(a - c)) / 3.0, 0.0, 1.0)

EP_Math_confidence(float direction, float agreementValue, float inverseEntropy) =>
    EP_Math_clamp(math.abs(direction) * 0.45 + agreementValue * 0.30 + inverseEntropy * 0.25, 0.0, 1.0)

// Embedded Final variant: its near-zero denominator loses a negative sign.
// Retained explicitly for historical comparisons; current safeDiv is unchanged.
EP_Math_legacySafeDiv(float numerator, float denominator, float epsilon = 1e-6) =>
    numerator / (math.abs(denominator) < epsilon ? epsilon : denominator)

EP_Math_legacyKineticSaturation(float value, float scale) =>
    float normalized = math.abs(value) / math.max(scale, 1e-6)
    EP_Math_clamp(math.tan(EP_Math_clamp(normalized * math.pi / 4.0, 0.0, math.pi / 4.0)), 0.0, 1.0)
// END EP_Math/3

// BEGIN EP_Types/4
