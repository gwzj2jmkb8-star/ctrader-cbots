int zoneLifetime = input.int(80, "Zone lifetime (bars)", minval=1, maxval=500, group=G_STRUCTURE)
int structureWindow = input.int(12, "Structure gate window", minval=1, maxval=100, group=G_STRUCTURE)
float chochAtr = input.float(0.25, "CHoCH displacement (ATR)", minval=0.0, step=0.05, group=G_STRUCTURE)

const string G_CONTEXT = "03 | Clouds, waves and reversion"
