//@version=6
// @description Professional Rescue Engine for ETHER POISON.
// Implements deterministic position recovery and tactical harvesting.

import EP_Math as math_ep
import EP_Types as types_ep

// =============================================================================
// 01. RESCUE CONFIGURATION - PROFESSIONAL GRADE
// =============================================================================
var string G_RESCUE = "Rescue Engine Settings"
rescue_min_dist    = input.float(1.5, "Min Adverse Distance (ATR x)", minval=0.1, step=0.1, group=G_RESCUE)
rescue_target_avg  = input.float(0.5, "Target Avg. Distance (Ticks)", step=0.1, group=G_RESCUE)
rescue_harvest_pct = input.float(50.0, "Harvest Amount (%)", minval=1.0, maxval=100.0, group=G_RESCUE)
rescue_max_cycles  = input.int(3, "Max Rescue Cycles", minval=1, group=G_RESCUE)

// =============================================================================
// 02. RECOVERY MATH
// =============================================================================

// Calculates the required quantity to move the average price to the target
f_calc_rescue_qty(float current_qty, float current_avg, float rescue_price, float target_avg, bool isLong) =>
    float denominator = isLong ? (target_avg - rescue_price) : (rescue_price - target_avg)
    float numerator = isLong ? current_qty * (current_avg - target_avg) : current_qty * (target_avg - current_avg)
    
    denominator > 0 and numerator > 0 ? numerator / denominator : 0.0

// =============================================================================
// 03. RESCUE STATE TRACKER
// =============================================================================

type RescueState
    int cycles = 0
    float lastRescuePrice = na
    bool isRecovering = false

var RescueState rState = RescueState.new()

// =============================================================================
// 04. EXECUTION LOGIC (PROFESSIONAL)
// =============================================================================

// Determine if we are in a "Rescue Window"
f_check_rescue_window(float entry_price, bool isLong) =>
    float atr = ta.atr(14)
    float dist = isLong ? (entry_price - close) : (close - entry_price)
    dist > (rescue_min_dist * atr)

// The Rescue Process
f_execute_rescue(float entry_price, float current_qty, bool isLong) =>
    float atr = ta.atr(14)
    float rescue_price = close
    float target_avg = isLong ? rescue_price + (rescue_target_avg * syminfo.mintick) : rescue_price - (rescue_target_avg * syminfo.mintick)
    
    if f_check_rescue_window(entry_price, isLong) and rState.cycles < rescue_max_cycles
        float addQty = f_calc_rescue_qty(current_qty, entry_price, rescue_price, target_avg, isLong)
        rState.cycles += 1
        rState.lastRescuePrice := rescue_price
        rState.isRecovering := true
        addQty
    else
        0.0

// Tactical Harvesting: Exiting part of the position when the "Energy" returns
f_check_harvest(float entry_price, float current_qty, bool isLong, float kinetic_mag) =>
    float profit = isLong ? (close - entry_price) : (entry_price - close)
    // Harvest if we have a small profit AND kinetic energy is fading (Exhaustion)
    bool harvestCondition = profit > 0 and kinetic_mag < 0.3
    
    harvestCondition ? (current_qty * (rescue_harvest_pct / 100.0)) : 0.0

// =============================================================================
// 05. EXPORT FOR MASTER
// =============================================================================

// These are used by the Master Orchestrator to trigger strategy.entry/exit
plot(rState.cycles, "Rescue Cycle Count", display=display.none)
plot(rState.isRecovering ? 1 : 0, "Recovery Mode Active", display=display.none)
