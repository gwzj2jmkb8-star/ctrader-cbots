// @description Shared ETHER state vocabulary v2.
enum EP_Types_Direction
    LONG = "LONG"
    SHORT = "SHORT"
    WAIT = "WAIT"

enum EP_Types_EnergyState
    EXPANSION = "EXPANSION"
    IMPULSE = "IMPULSE"
    BALANCED = "BALANCED"
    COMPRESSION = "COMPRESSION"

enum EP_Types_GateState
    OPEN = "OPEN"
    PARTIAL = "PARTIAL"
    BLOCKED = "BLOCKED"

enum EP_Types_FvgState
    NONE = "NONE"
    FRESH = "FRESH"
    PARTIAL = "PARTIAL"
    INVERTED = "INVERTED"
    FILLED = "FILLED"

enum EP_Types_EntropyState
    ORDERED = "ORDERED"
    MIXED = "MIXED"
    DIFFUSE = "DIFFUSE"
    CHAOTIC = "CHAOTIC"

enum EP_Types_CloudLane
    FAST = "FAST"
    BALANCED = "BALANCED"
    SLOW = "SLOW"

// Compatibility vocabulary retained for scripts built on the first ETHER API.
enum EP_Types_Toxicity
    LETHAL = "LETHAL"
    VIRAL = "VIRAL"
    DORMANT = "DORMANT"
    STABLE = "STABLE"

enum EP_Types_EnergyFlow
    ASCENDING = "ASCENDING"
    DESCENDING = "DESCENDING"
    VORTEX = "VORTEX"
    STATIC = "STATIC"

enum EP_Types_Permission
    OFFENSIVE = "OFFENSIVE"
    DEFENSIVE = "DEFENSIVE"
    WAIT = "WAIT"

type EP_Types_KineticState
    float magnitude = 0.0
    EP_Types_Toxicity toxicity = EP_Types_Toxicity.DORMANT
    EP_Types_EnergyFlow flow = EP_Types_EnergyFlow.STATIC
    float conviction = 0.0

type EP_Types_OutcomeState
    EP_Types_Permission permission = EP_Types_Permission.WAIT
    float score = 0.0
    string reason = "NONE"
    string signature = "NONE"

type EP_Types_EngineState
    EP_Types_Direction direction = EP_Types_Direction.WAIT
    EP_Types_EnergyState energy = EP_Types_EnergyState.BALANCED
    EP_Types_GateState gate = EP_Types_GateState.BLOCKED
    float longScore = 0.0
    float shortScore = 0.0
    float conviction = 0.0
    string reason = "WAIT"

// Complete output contract of the Multiplexer Cloud.
type EP_Types_CloudState
    float spanA = na
    float spanB = na
    float center = na
    float widthAtr = 0.0
    float direction = 0.0
    float entropyFast = 1.0
    float entropyMedium = 1.0
    float entropySlow = 1.0
    float entropyComposite = 1.0
    float tempAtten = 0.0
    float densityFast = 0.0
    float densityMedium = 0.0
    float densitySlow = 0.0
    float agreement = 0.0
    float confidence = 0.0
    EP_Types_EntropyState entropyState = EP_Types_EntropyState.CHAOTIC
    EP_Types_CloudLane dominantLane = EP_Types_CloudLane.BALANCED
    bool valid = false

EP_Types_directionValue(EP_Types_Direction direction) =>
    direction == EP_Types_Direction.LONG ? 1 : direction == EP_Types_Direction.SHORT ? -1 : 0

EP_Types_permissionDirection(EP_Types_Permission permission) =>
    permission == EP_Types_Permission.OFFENSIVE ? 1 : permission == EP_Types_Permission.DEFENSIVE ? -1 : 0

EP_Types_entropyName(EP_Types_EntropyState state) =>
    state == EP_Types_EntropyState.ORDERED ? "ORDERED" : state == EP_Types_EntropyState.MIXED ? "MIXED" : state == EP_Types_EntropyState.DIFFUSE ? "DIFFUSE" : "CHAOTIC"

EP_Types_laneName(EP_Types_CloudLane lane) =>
    lane == EP_Types_CloudLane.FAST ? "FAST" : lane == EP_Types_CloudLane.SLOW ? "SLOW" : "BALANCED"

// 03_RESCUE_ENGINE / jade state, promoted into the shared type contract.
type EP_Types_RescueState
    int cycles = 0
    float lastRescuePrice = na
    bool isRecovering = false
// END EP_Types/4

// BEGIN EP_KineticCore/1
// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0.
// © ClassicPotatoChamberXII
// @description Reusable knowledge from 01_KINETIC_CORE, jade and final/master variants.
// Current v2 path; same formula and epsilon conventions.
EP_KineticCore_magnitude(float source, float sourcePast, float atr, float scale) =>
    EP_Math_kinetic(EP_Math_distanceAtr(source, sourcePast, atr), scale)

EP_KineticCore_f_map_toxicity(float mag, float thresholdLethal, float thresholdViral) =>
    mag >= thresholdLethal ? EP_Types_Toxicity.LETHAL : mag >= thresholdViral ? EP_Types_Toxicity.VIRAL : mag > 0.1 ? EP_Types_Toxicity.DORMANT : EP_Types_Toxicity.STABLE

EP_KineticCore_f_determine_flow(float src, simple int len) =>
    float diff = src - src[len]
    diff > 0.0 ? EP_Types_EnergyFlow.ASCENDING : diff < 0.0 ? EP_Types_EnergyFlow.DESCENDING : EP_Types_EnergyFlow.STATIC

// Original shard uses mintick as its ATR denominator floor.
EP_KineticCore_f_calculate_magnitude(float src, simple int len, float scale, float tickSize) =>
    float change = src - src[len]
    float vol = ta.atr(len)
    EP_Math_kinetic(math.abs(change) / math.max(vol, tickSize), scale)

EP_KineticCore_state(float magnitudeValue, EP_Types_EnergyFlow flow, float lethal, float viral) =>
    EP_Types_Toxicity toxicity = EP_KineticCore_f_map_toxicity(magnitudeValue, lethal, viral)
    EP_Types_KineticState.new(magnitudeValue, toxicity, flow, magnitudeValue * (toxicity == EP_Types_Toxicity.LETHAL ? 1.0 : 0.5))

EP_KineticCore_f_get_kinetic_state(float src, float scale, float thL, float thV) =>
    float mag = EP_KineticCore_f_calculate_magnitude(src, 14, scale, syminfo.mintick)
    EP_KineticCore_state(mag, EP_KineticCore_f_determine_flow(src, 14), thL, thV)

// Early EP_Engines and embedded Final variants handle negative scale differently
// from Math v2. Preserve the actual historical formula under an explicit API.
EP_KineticCore_legacyMagnitude(float source, float sourcePast, float atr, float scale) =>
    float raw = math.abs(source - sourcePast) / math.max(atr, 1e-6)
    float bounded = math.min(raw / math.max(scale, 1e-6), 1.0)
    math.min(math.tan(bounded * math.pi / 4.0), 1.0)

// Exact embedded Final convention: mintick floor + legacy non-absolute scale.
EP_KineticCore_finalKineticState(float src, float scale, float lethal, float viral) =>
    float raw = math.abs(src - src[14]) / math.max(ta.atr(14), syminfo.mintick)
    float mag = EP_Math_legacyKineticSaturation(raw, scale)
    EP_KineticCore_state(mag, EP_KineticCore_f_determine_flow(src, 14), lethal, viral)
// END EP_KineticCore/1

// BEGIN EP_RescueEngine/1
// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0.
// © ClassicPotatoChamberXII
// @description Recovery math and explicit state from 03_RESCUE_ENGINE and final variants.
EP_RescueEngine_f_calc_rescue_qty(float current_qty, float current_avg, float rescue_price, float target_avg, bool isLong) =>
    float denominator = isLong ? target_avg - rescue_price : rescue_price - target_avg
    float numerator = isLong ? current_qty * (current_avg - target_avg) : current_qty * (target_avg - current_avg)
    denominator > 0.0 and numerator > 0.0 ? numerator / denominator : 0.0

EP_RescueEngine_quantity(float currentQuantity, float currentAverage, float rescuePrice, float targetAverage, bool isLong, float maximumMultiple) =>
    float raw = EP_RescueEngine_f_calc_rescue_qty(currentQuantity, currentAverage, rescuePrice, targetAverage, isLong)
    math.min(raw, currentQuantity * math.max(maximumMultiple, 0.0))

EP_RescueEngine_adverseDistance(float entryPrice, float price, bool isLong) =>
    isLong ? entryPrice - price : price - entryPrice

EP_RescueEngine_f_check_rescue_window(float entryPrice, bool isLong, float minimumDistance) =>
    float atr = ta.atr(14)
    EP_RescueEngine_adverseDistance(entryPrice, close, isLong) > minimumDistance * atr

// Explicit caller-owned state replaces the fragment's hidden global rState.
// This legacy API calculates a proposal, never submits a broker order.
EP_RescueEngine_f_execute_rescue(EP_Types_RescueState state, float entryPrice, float currentQty, bool isLong, float minimumDistance, float targetTicks, int maximumCycles) =>
    bool window = EP_RescueEngine_f_check_rescue_window(entryPrice, isLong, minimumDistance)
    float target = isLong ? close + targetTicks * syminfo.mintick : close - targetTicks * syminfo.mintick
    float addQty = 0.0
    if window and state.cycles < maximumCycles
        addQty := EP_RescueEngine_f_calc_rescue_qty(currentQty, entryPrice, close, target, isLong)
        state.cycles += 1
        state.lastRescuePrice := close
        state.isRecovering := true
    addQty

EP_RescueEngine_f_check_harvest(float entryPrice, float currentQty, bool isLong, float kineticMagnitude, float harvestPercent) =>
    float profit = isLong ? close - entryPrice : entryPrice - close
    profit > 0.0 and kineticMagnitude < 0.3 ? currentQty * harvestPercent / 100.0 : 0.0

// Historical Final has a persistent cycle counter, distinct from shard rState.
// Caller passes its counter explicitly; retain increment-on-window semantics.
EP_RescueEngine_f_handle_rescue(float entry, float qty, bool isLong, float minimumDistance, float targetTicks, int maximumCycles, int cycles) =>
    float atr = ta.atr(14)
    float distance = EP_RescueEngine_adverseDistance(entry, close, isLong)
    int nextCycles = cycles
    float result = 0.0
    if distance > minimumDistance * atr and cycles < maximumCycles
        float target = isLong ? close + targetTicks * syminfo.mintick : close - targetTicks * syminfo.mintick
        result := EP_RescueEngine_f_calc_rescue_qty(qty, entry, close, target, isLong)
        nextCycles += 1
    [result, nextCycles]
// END EP_RescueEngine/1

// BEGIN EP_SpaceTimeGrid/1
// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0.
// © ClassicPotatoChamberXII
// @description Shared geometry from 04_SPACE_TIME_GRID, jade and the attached v2 master.
EP_SpaceTimeGrid_midpoint(float h, float l) =>
    (h + l) * 0.5

EP_SpaceTimeGrid_classical(float h, float l, simple int tenkanLength, simple int kijunLength, simple int spanBLength) =>
    float tenkan = EP_SpaceTimeGrid_midpoint(ta.highest(h, tenkanLength), ta.lowest(l, tenkanLength))
    float kijun = EP_SpaceTimeGrid_midpoint(ta.highest(h, kijunLength), ta.lowest(l, kijunLength))
    [tenkan, kijun, (tenkan + kijun) * 0.5, EP_SpaceTimeGrid_midpoint(ta.highest(h, spanBLength), ta.lowest(l, spanBLength))]

EP_SpaceTimeGrid_rapid(float source, float atr, float kinetic, simple int length, float expansion) =>
    float center = ta.ema(source, length)
    float width = atr * expansion * (0.5 + kinetic)
    [center, width, center + width, center - width]

EP_SpaceTimeGrid_volatility(float source, float atr, float signedEnergy, simple int fastLength, simple int slowLength, float contourAtr) =>
    float fastBasis = ta.ema(source, fastLength)
    float slowBasis = ta.ema(source, slowLength)
    float contour = atr * contourAtr * signedEnergy
    [fastBasis, slowBasis, contour, fastBasis + contour, slowBasis - contour]

EP_SpaceTimeGrid_reversion(float source, simple int length, float deviationMultiple) =>
    float basis = ta.ema(source, length)
    float deviation = ta.stdev(source, length) * deviationMultiple
    [basis, deviation, basis + deviation, basis - deviation]

EP_SpaceTimeGrid_wave(float source, simple int length) =>
    ta.ema(source - source[1], length)

// Original shard uses percent-price rapid expansion and SMA SuperBoll.
// Return all calculated channels, including previously hidden wave-energy data.
EP_SpaceTimeGrid_legacyGrid(simple int spanALength, simple int spanBLength, float rapidPercent, simple int bollLength, float bollMultiple, simple int railLength) =>
    float spanA = EP_SpaceTimeGrid_midpoint(ta.highest(high, spanALength), ta.lowest(low, spanALength))
    float spanB = EP_SpaceTimeGrid_midpoint(ta.highest(high, spanBLength), ta.lowest(low, spanBLength))
    float rapidA = spanA * (1.0 + rapidPercent * 0.01)
    float rapidB = spanB * (1.0 - rapidPercent * 0.01)
    float energy = ta.sma(math.abs(close - close[1]), railLength)
    float basis = ta.sma(close, bollLength)
    float deviation = ta.stdev(close, bollLength)
    float upper = basis + deviation * bollMultiple
    float lower = basis - deviation * bollMultiple
    [spanA, spanB, math.max(spanA, spanB), math.min(spanA, spanB), rapidA, rapidB,
     energy, ta.vwap(hlc3), basis, deviation, upper, lower, close > upper and close > high[1], close < lower and close < low[1]]

// Forward displacement and historical cloud sampling are separate conventions.
EP_SpaceTimeGrid_historicalCloud(float spanA, float spanB, simple int displacement) =>
    [spanA[displacement], spanB[displacement]]
// END EP_SpaceTimeGrid/1

// BEGIN EP_Engines/3
// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0.
// © ClassicPotatoChamberXII
// @description ETHER analytical engines v2, including Multiplexer Cloud.
EP_Engines_midpoint(float highValue, float lowValue) =>
    EP_SpaceTimeGrid_midpoint(highValue, lowValue)

EP_Engines_kineticMagnitude(float source, float sourcePast, float atr, float scale) =>
    EP_KineticCore_magnitude(source, sourcePast, atr, scale)

EP_Engines_zScore(float source, simple int length) =>
    float basis = ta.sma(source, length)
    float deviation = ta.stdev(source, length)
    deviation > 0.0 ? (source - basis) / deviation : 0.0

EP_Engines_normalizeSigned(float value, float scale) =>
    EP_Math_norm(value, scale)

EP_Engines_rescueQuantity(float currentQuantity, float currentAverage, float rescuePrice, float targetAverage, bool isLong, float maximumMultiple) =>
    EP_RescueEngine_quantity(currentQuantity, currentAverage, rescuePrice, targetAverage, isLong, maximumMultiple)

// Three-horizon entropy multiplexer. Density is inverse entropy multiplied by
// temporal attenuation; no lane receives hidden discretionary weight.
EP_Engines_multiplexerCloud(
    float source,
    float atr,
    simple int fastLength,
    simple int mediumLength,
    simple int slowLength,
    float temperature,
    float attenuationFloor,
    float contourAtr) =>
    int fastN = math.max(fastLength, 2)
    int mediumN = math.max(mediumLength, fastN + 1)
    int slowN = math.max(slowLength, mediumN + 1)
    float atrSafe = math.max(math.abs(atr), 1e-6)

    float returnNorm = EP_Math_norm(source - source[1], atrSafe)
    float probabilityUp = EP_Math_clamp(0.5 + returnNorm * 0.5, 1e-6, 1.0 - 1e-6)
    float localEntropy = EP_Math_binaryEntropy(probabilityUp)
    float entropyFast = ta.ema(localEntropy, fastN)
    float entropyMedium = ta.ema(localEntropy, mediumN)
    float entropySlow = ta.ema(localEntropy, slowN)
    float entropyComposite = EP_Math_blend3(entropyFast, 1.0, entropyMedium, 1.0, entropySlow, 1.0)
    float attenuation = EP_Math_tempAtten(entropyComposite, temperature, attenuationFloor)

    float directionFast = EP_Math_norm(ta.ema(source - source[1], fastN), atrSafe)
    float directionMedium = EP_Math_norm(ta.ema(source - source[1], mediumN), atrSafe)
    float directionSlow = EP_Math_norm(ta.ema(source - source[1], slowN), atrSafe)
    float densityFast = math.max(1.0 - entropyFast, 0.0) * attenuation
    float densityMedium = math.max(1.0 - entropyMedium, 0.0) * attenuation
    float densitySlow = math.max(1.0 - entropySlow, 0.0) * attenuation
    float densityTotal = densityFast + densityMedium + densitySlow

    float centerFast = ta.ema(source, fastN)
    float centerMedium = ta.ema(source, mediumN)
    float centerSlow = ta.ema(source, slowN)
    float center = densityTotal > 0.0 ? EP_Math_blend3(centerFast, densityFast, centerMedium, densityMedium, centerSlow, densitySlow) : centerMedium
    float direction = densityTotal > 0.0 ? EP_Math_blend3(directionFast, densityFast, directionMedium, densityMedium, directionSlow, densitySlow) : 0.0
    float laneAgreement = EP_Math_agreement(directionFast, directionMedium, directionSlow)
    float inverseEntropy = 1.0 - entropyComposite
    float cloudConfidence = EP_Math_confidence(direction, laneAgreement, inverseEntropy)
    float widthAtr = math.max(contourAtr, 0.0) * (0.35 + entropyComposite * 0.65) * (0.50 + math.abs(direction) * 0.50) * attenuation
    float directionalShift = direction * atrSafe * widthAtr * 0.35
    float halfWidth = atrSafe * widthAtr
    float spanA = center + directionalShift + halfWidth
    float spanB = center + directionalShift - halfWidth

    EP_Types_EntropyState entropyState = entropyComposite <= 0.25 ? EP_Types_EntropyState.ORDERED : entropyComposite <= 0.50 ? EP_Types_EntropyState.MIXED : entropyComposite <= 0.75 ? EP_Types_EntropyState.DIFFUSE : EP_Types_EntropyState.CHAOTIC
    EP_Types_CloudLane dominantLane = densityFast >= densityMedium and densityFast >= densitySlow ? EP_Types_CloudLane.FAST : densitySlow >= densityFast and densitySlow >= densityMedium ? EP_Types_CloudLane.SLOW : EP_Types_CloudLane.BALANCED
    bool valid = not na(spanA) and not na(spanB) and atrSafe > 0.0

    EP_Types_CloudState.new(spanA, spanB, center, widthAtr, direction,
         entropyFast, entropyMedium, entropySlow, entropyComposite, attenuation,
         densityFast, densityMedium, densitySlow, laneAgreement, cloudConfidence,
         entropyState, dominantLane, valid)
// END EP_Engines/3

// BEGIN EP_Nocturne/2
// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0.
// © ClassicPotatoChamberXII
// @description Density-aware Nocturne rendering helpers. No inputs or orders.
EP_Nocturne_clampAlpha(float value) =>
    int(math.round(math.max(0.0, math.min(100.0, value))))

// High confidence and strong attenuation make the object more visible, while
// high entropy pushes it deeper into the background.
EP_Nocturne_densityAlpha(float confidence, float entropy, float tempAtten, int lightAlpha, int darkAlpha) =>
    float visibility = math.max(0.0, math.min(1.0, confidence * tempAtten * (1.0 - entropy * 0.45)))
    EP_Nocturne_clampAlpha(darkAlpha - visibility * math.max(darkAlpha - lightAlpha, 0))

EP_Nocturne_directionalColor(color bull, color bear, color neutral, float direction, float deadband, int alpha) =>
    color base = direction > deadband ? bull : direction < -deadband ? bear : neutral
    color.new(base, EP_Nocturne_clampAlpha(alpha))

EP_Nocturne_spectralColor(color base, float density, int faintAlpha, int strongAlpha) =>
    float boundedDensity = math.max(0.0, math.min(1.0, density))
    color.new(base, EP_Nocturne_clampAlpha(faintAlpha - boundedDensity * math.max(faintAlpha - strongAlpha, 0)))

EP_Nocturne_stateGlyph(float direction, float entropy, float confidence) =>
    entropy >= 0.75 ? "CHAOS" : confidence >= 0.75 ? (direction >= 0.0 ? "ASCEND" : "DESCEND") : entropy <= 0.25 ? "ORDER" : "VEIL"

// NOCTURNE_VISUALS / jade palette API. Palette values are caller-owned inputs.
EP_Nocturne_f_get_toxicity_color(EP_Types_Toxicity tox, color lethal, color viral, color dormant, color stable) =>
    tox == EP_Types_Toxicity.LETHAL ? lethal : tox == EP_Types_Toxicity.VIRAL ? viral : tox == EP_Types_Toxicity.DORMANT ? dormant : stable

// The original renderer was a color-selection scaffold, not an actual plot.
// Export geometry + colors so callers can render with global plots or objects.
EP_Nocturne_f_render_nocturne(float spanA, float spanB, float rapidA, float rapidB, EP_Types_Toxicity tox, color lethal, color viral, color dormant, color stable, color shadow, color ghost) =>
    color cloudColor = EP_Nocturne_f_get_toxicity_color(tox, lethal, viral, dormant, stable)
    color rapidColor = tox == EP_Types_Toxicity.LETHAL ? lethal : shadow
    color railColor = tox == EP_Types_Toxicity.VIRAL ? viral : ghost
    [math.max(spanA, spanB), math.min(spanA, spanB), math.max(rapidA, rapidB), math.min(rapidA, rapidB), cloudColor, rapidColor, railColor]

// Existing cockpit data survives, but table ownership/position is the caller's.
EP_Nocturne_f_render_cockpit(table cockpit, EP_Types_KineticState state, EP_Types_Permission perm, color textColor, color bullColor, color bearColor, color dormant, color stable) =>
    table.cell(cockpit, 0, 0, "ETHER", text_color=textColor, text_size=size.tiny)
    table.cell(cockpit, 1, 0, "KNOWLEDGE", text_color=bullColor, text_size=size.tiny)
    table.cell(cockpit, 0, 1, "TOXICITY", text_color=textColor, text_size=size.tiny)
    table.cell(cockpit, 1, 1, str.tostring(state.toxicity), bgcolor=EP_Nocturne_f_get_toxicity_color(state.toxicity, bullColor, bearColor, dormant, stable), text_color=textColor, text_size=size.tiny)
    table.cell(cockpit, 0, 2, "FLOW", text_color=textColor, text_size=size.tiny)
    table.cell(cockpit, 1, 2, str.tostring(state.flow), text_color=bullColor, text_size=size.tiny)
    table.cell(cockpit, 0, 3, "LEGACY PERMIT", text_color=textColor, text_size=size.tiny)
    table.cell(cockpit, 1, 3, str.tostring(perm), text_color=perm == EP_Types_Permission.OFFENSIVE ? bullColor : bearColor, text_size=size.tiny)
    table.cell(cockpit, 0, 4, "CONVICTION", text_color=textColor, text_size=size.tiny)
    table.cell(cockpit, 1, 4, str.tostring(state.conviction * 100.0, "#.0") + "%", text_color=textColor, text_size=size.tiny)
// END EP_Nocturne/2

// BEGIN EP_SpatialGates/1
// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0.
// © ClassicPotatoChamberXII
// @description FVG and permission APIs from 02_SPATIAL_GATES, jade and master.
// Caller supplies historical values explicitly; >= preserves attached v2 rules.
EP_SpatialGates_detectFvg(float h, float l, float highTwoBarsAgo, float lowTwoBarsAgo, float atr, float minimumAtr) =>
    [l > highTwoBarsAgo and l - highTwoBarsAgo >= atr * minimumAtr,
     h < lowTwoBarsAgo and lowTwoBarsAgo - h >= atr * minimumAtr]

// Legacy shard uses strict > on gap size, with a 14-bar ATR.
EP_SpatialGates_f_detect_fvg(float minimumAtr) =>
    float atr = ta.atr(14)
    [low > high[2] and low - high[2] > minimumAtr * atr,
     high < low[2] and low[2] - high > minimumAtr * atr]

EP_SpatialGates_f_get_spatial_permission(bool bullFvg, bool bearFvg, bool bBull, bool bBear, bool cBull, bool cBear) =>
    bool longAllowed = bullFvg and (bBull or cBull)
    bool shortAllowed = bearFvg and (bBear or cBear)
    longAllowed ? EP_Types_Permission.OFFENSIVE : shortAllowed ? EP_Types_Permission.DEFENSIVE : EP_Types_Permission.WAIT

// Old shard's standing level conditions are kept distinct from v2 crossover BOS.
EP_SpatialGates_legacyStructure(simple int lookback, float chochAtr) =>
    float ph = ta.pivothigh(lookback, lookback)
    float pl = ta.pivotlow(lookback, lookback)
    var float lastHigh = na
    var float lastLow = na
    if not na(ph)
        lastHigh := ph
    if not na(pl)
        lastLow := pl
    float atr = ta.atr(14)
    bool bull = close > lastHigh
    bool bear = close < lastLow
    [ph, pl, lastHigh, lastLow, bull, bear, bull and close - lastHigh > chochAtr * atr, bear and lastLow - close > chochAtr * atr]

EP_SpatialGates_legacyPermission(float minimumAtr, simple int lookback, float chochAtr) =>
    [bullFvg, bearFvg] = EP_SpatialGates_f_detect_fvg(minimumAtr)
    [ph, pl, lastH, lastL, bull, bear, chochBull, chochBear] = EP_SpatialGates_legacyStructure(lookback, chochAtr)
    EP_SpatialGates_f_get_spatial_permission(bullFvg, bearFvg, bull, bear, chochBull, chochBear)
// END EP_SpatialGates/1

// BEGIN EP_Candles/2
// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0.
// © ClassicPotatoChamberXII
// @description Synthetic HA geometry and causal relative-volume measurements.
// Call once, unconditionally, on standard OHLC. Previous BAR values deliberately
// prevent fill recalculations from advancing the HA recurrence a second time.
EP_Candles_heikinAshi(float o, float h, float l, float c) =>
    float hc = (o + h + l + c) * 0.25
    var float ho = na
    ho := na(ho[1]) ? (o + c) * 0.5 : (ho[1] + hc[1]) * 0.5
    [ho, math.max(h, math.max(ho, hc)), math.min(l, math.min(ho, hc)), hc]

// Reference excludes the current bar. No fake neutral volume during warmup,
// missing feeds or a zero-volume baseline. Zero current volume is valid.
EP_Candles_relativeVolume(float v, simple int length) =>
    float baseline = ta.sma(v, length)[1]
    bool valid = not na(v) and v >= 0.0 and not na(baseline) and baseline > 0.0
    [valid ? v / baseline : na, baseline, valid]

// OHLC close-location allocation is a proxy, NOT bid/ask volume or order flow.
EP_Candles_buyShare(float h, float l, float c) =>
    h > l ? math.max(0.0, math.min(1.0, (c - l) / (h - l))) : 0.5

EP_Candles_bodyFraction(float o, float h, float l, float c) =>
    h > l ? math.max(0.0, math.min(1.0, math.abs(c - o) / (h - l))) : 0.0

// Candle strength is geometry, not a trade or aggressor-volume classification.
EP_Candles_anatomy(float o, float h, float l, float c, float tick, float bodyThreshold, float wickToleranceTicks) =>
    float body = EP_Candles_bodyFraction(o, h, l, c)
    float upper = math.max(0.0, h - math.max(o, c))
    float lower = math.max(0.0, math.min(o, c) - l)
    float tolerance = math.max(wickToleranceTicks, 0.0) * tick
    bool strongUp = c > o and body >= bodyThreshold and lower <= tolerance
    bool strongDown = c < o and body >= bodyThreshold and upper <= tolerance
    [body, upper, lower, strongUp, strongDown]

// Relative width is an overlay design, not a claim to replicate native chart spacing.
EP_Candles_volumeWidth(float EP_Candles_relativeVolume, float widthAtOne, float exponent) =>
    float width = na(EP_Candles_relativeVolume) ? widthAtOne : widthAtOne * math.pow(math.max(EP_Candles_relativeVolume, 0.0), math.max(exponent, 0.0))
    math.max(0.06, math.min(0.92, width))

type EP_Candles_VolumeCanvas
    array<box> upperBodies
    array<box> lowerBodies
    array<line> wicks
    int lastStamp = na

EP_Candles_createCanvas() =>
    EP_Candles_VolumeCanvas.new(array.new_box(), array.new_box(), array.new_line())

EP_Candles_drawVolume(
    EP_Candles_VolumeCanvas canvas,
    int stamp,
    int duration,
    float o,
    float h,
    float l,
    float c,
    float widthFraction,
    float buyFraction,
    bool splitProxy,
    color directionInk,
    color buyInk,
    color sellInk,
    int alpha,
    int capacity
) =>
    int retained = math.max(1, math.min(capacity, 100))
    // Reuse IDs on the same bar and recycle the oldest IDs when the pool is full.
    box upperBody = na
    box lowerBody = na
    line candleWick = na
    if canvas.lastStamp == stamp and array.size(canvas.wicks) > 0
        upperBody := array.pop(canvas.upperBodies)
        lowerBody := array.pop(canvas.lowerBodies)
        candleWick := array.pop(canvas.wicks)
    else if array.size(canvas.wicks) >= retained
        upperBody := array.shift(canvas.upperBodies)
        lowerBody := array.shift(canvas.lowerBodies)
        candleWick := array.shift(canvas.wicks)
    while array.size(canvas.wicks) >= retained
        box.delete(array.shift(canvas.upperBodies))
        box.delete(array.shift(canvas.lowerBodies))
        line.delete(array.shift(canvas.wicks))
    int halfWidth = int(math.max(1.0, duration * widthFraction * 0.5))
    float top = math.max(o, c)
    float bottom = math.min(o, c)
    float split = splitProxy ? bottom + (top - bottom) * math.max(0.0, math.min(1.0, buyFraction)) : bottom
    if na(candleWick)
        candleWick := line.new(stamp, l, stamp, h, xloc=xloc.bar_time)
        upperBody := box.new(stamp - halfWidth, top, stamp + halfWidth, split, xloc=xloc.bar_time)
        lowerBody := box.new(stamp - halfWidth, split, stamp + halfWidth, bottom, xloc=xloc.bar_time)
    line.set_xy1(candleWick, stamp, l)
    line.set_xy2(candleWick, stamp, h)
    line.set_color(candleWick, directionInk)
    box.set_lefttop(upperBody, stamp - halfWidth, top)
    box.set_rightbottom(upperBody, stamp + halfWidth, split)
    box.set_bgcolor(upperBody, color.new(splitProxy ? sellInk : directionInk, alpha))
    box.set_border_color(upperBody, directionInk)
    box.set_lefttop(lowerBody, stamp - halfWidth, split)
    box.set_rightbottom(lowerBody, stamp + halfWidth, bottom)
    box.set_bgcolor(lowerBody, color.new(buyInk, splitProxy ? alpha : 100))
    box.set_border_color(lowerBody, splitProxy ? directionInk : color.new(directionInk, 100))
    array.push(canvas.wicks, candleWick)
    array.push(canvas.upperBodies, upperBody)
    array.push(canvas.lowerBodies, lowerBody)
    canvas.lastStamp := stamp
    canvas
// END EP_Candles/2

// BEGIN EP_ExecutionLedger/1
// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0.
// © ClassicPotatoChamberXII
// @description Passive fill-record renderer. No orders, signals, inputs or strategy globals.
type EP_ExecutionLedger_EntryFill
    string id
    int stamp
    int entryBar
    float price
    float quantity

type EP_ExecutionLedger_ClosedFill
    EP_ExecutionLedger_EntryFill entry
    int index
    string exitId
    int exitStamp
    float exitPrice
    float profit
    float profitPercent

type EP_ExecutionLedger_Ledger
    array<label> labels
    array<string> activeKeys
    int closedCursor = 0

EP_ExecutionLedger_create() =>
    EP_ExecutionLedger_Ledger.new(array.new_label(), array.new_string(), 0)

EP_ExecutionLedger_tradeKey(EP_ExecutionLedger_EntryFill entry) =>
    entry.id + "|" + str.tostring(entry.stamp) + "|" + str.tostring(entry.entryBar)

EP_ExecutionLedger_addLabel(EP_ExecutionLedger_Ledger state, int stamp, float price, string caption, string details, bool isBuy, color ink, int capacity) =>
    while array.size(state.labels) >= math.max(capacity, 1)
        label.delete(array.shift(state.labels))
    label tag = label.new(stamp, price, caption, xloc=xloc.bar_time, yloc=yloc.price,
         style=isBuy ? label.style_label_up : label.style_label_down,
         color=color.new(ink, 22), textcolor=color.white, size=size.small, tooltip=details)
    array.push(state.labels, tag)

// State and labels intentionally share ordinary-var rollback in the caller.
// Closed records are processed before current open entries so partials retain identity.
EP_ExecutionLedger_observe(EP_ExecutionLedger_Ledger state, array<EP_ExecutionLedger_EntryFill> openFills, array<EP_ExecutionLedger_ClosedFill> closedFills, int closedCount, bool visible, int capacity, color buyColor, color sellColor, color profitColor, color lossColor, color flatColor, float positionAverage, float positionQuantity) =>
    if array.size(closedFills) > 0
        for i = 0 to array.size(closedFills) - 1
            EP_ExecutionLedger_ClosedFill fill = array.get(closedFills, i)
            EP_ExecutionLedger_EntryFill entry = fill.entry
            string key = EP_ExecutionLedger_tradeKey(entry)
            bool wasLong = entry.quantity > 0.0
            if not array.includes(state.activeKeys, key)
                if visible
                    EP_ExecutionLedger_addLabel(state, entry.stamp, entry.price,
                         (wasLong ? "BUY · " : "SELL · ") + entry.id + "\n@ " + str.tostring(entry.price, format.mintick),
                         "Reconstructed entry. Closed portion Q " + str.tostring(math.abs(entry.quantity), "#.####"),
                         wasLong, wasLong ? buyColor : sellColor, capacity)
                array.push(state.activeKeys, key)
            if visible
                color ink = fill.profit > 0.0 ? profitColor : fill.profit < 0.0 ? lossColor : flatColor
                string caption = (wasLong ? "SELL · EXIT LONG" : "BUY · EXIT SHORT") + "\n@ " + str.tostring(fill.exitPrice, format.mintick) + " | Q " + str.tostring(math.abs(entry.quantity), "#.####")
                string details = "Closed record #" + str.tostring(fill.index + 1) + " | " + entry.id + " -> " + fill.exitId + "\nP/L " + str.tostring(fill.profit, "#.##") + " | return " + str.tostring(fill.profitPercent, "#.##") + "%\nPartial exits are closed records; reversals also open a new entry."
                EP_ExecutionLedger_addLabel(state, fill.exitStamp, fill.exitPrice, caption, details, not wasLong, ink, capacity)
    array<string> nextActiveKeys = array.new_string()
    if array.size(openFills) > 0
        for i = 0 to array.size(openFills) - 1
            EP_ExecutionLedger_EntryFill entry = array.get(openFills, i)
            string key = EP_ExecutionLedger_tradeKey(entry)
            array.push(nextActiveKeys, key)
            if visible and not array.includes(state.activeKeys, key)
                bool bought = entry.quantity > 0.0
                string caption = (bought ? "BUY · " : "SELL · ") + entry.id + "\n@ " + str.tostring(entry.price, format.mintick) + " | Q " + str.tostring(math.abs(entry.quantity), "#.####")
                string details = "Filled trade leg. Position average " + str.tostring(positionAverage, format.mintick) + " | total Q " + str.tostring(math.abs(positionQuantity), "#.####")
                EP_ExecutionLedger_addLabel(state, entry.stamp, entry.price, caption, details, bought, bought ? buyColor : sellColor, capacity)
    state.activeKeys := nextActiveKeys
    state.closedCursor := closedCount
    state
// END EP_ExecutionLedger/1

// BEGIN EP_MarketOrders/1
// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0.
// © ClassicPotatoChamberXII
// @description Market-engine eligibility. Order dispatch stays in the strategy.
EP_MarketOrders_entryEligible(bool approved, bool isLong, float positionSize) =>
    approved and (isLong ? positionSize <= 0.0 : positionSize >= 0.0)

EP_MarketOrders_rescueEligible(bool window, float quantity) =>
    window and quantity > 0.0
// END EP_MarketOrders/1

// BEGIN EP_LimitOrders/1
// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0.
// © ClassicPotatoChamberXII
// @description Resting-limit prices and lifecycle. No strategy orders or shared EP_Types dependency.
// Each primitive field explicitly persists across fill recalculation/rollback.
// A varip object reference alone does not make UDT fields intrabar-persistent.
// Drawings remain caller-owned ordinary var.
type EP_LimitOrders_Ticket
    varip bool active = false
    varip string id = ""
    varip string kind = ""
    varip bool isLong = true
    varip float price = na
    varip float quantity = na
    varip float positionAtArm = 0.0
    varip int zoneAtArm = na
    varip int bornBar = na
    varip int expiryBar = na
    varip int serial = 0
    varip int eventSerial = 0
    varip int eventBar = na
    varip int eventTime = na
    varip string event = "IDLE"
    varip string reason = ""
    varip float eventPrice = na

EP_LimitOrders_create() =>
    EP_LimitOrders_Ticket.new()

// Buy below current price / sell above current price; never silently convert a
// marketable limit into an immediate order. Price rounds away from current price.
EP_LimitOrders_entryPrice(bool isLong, string basis, float closePrice, float atr, float offsetAtr, int offsetTicks, float zoneTop, float zoneBottom, float tick) =>
    float raw = basis == "FVG midpoint" ? (zoneTop + zoneBottom) * 0.5 : basis == "FVG near edge" ? (isLong ? zoneTop : zoneBottom) : basis == "Ticks from close" ? closePrice + (isLong ? -1.0 : 1.0) * offsetTicks * tick : closePrice + (isLong ? -1.0 : 1.0) * atr * offsetAtr
    isLong ? math.floor(raw / tick) * tick : math.ceil(raw / tick) * tick

EP_LimitOrders_isPassive(bool isLong, float price, float currentPrice, float tick) =>
    not na(price) and price > 0.0 and (isLong ? price <= currentPrice - tick * 0.5 : price >= currentPrice + tick * 0.5)

// Close-calculated expiry: cancel at the expiry bar's close if still unfilled.
EP_LimitOrders_cancellationReason(EP_LimitOrders_Ticket ticket, int bar, float positionSize, bool oppositeApproval, bool cancelOpposite, bool zoneValid, bool cancelZone, bool harvesting) =>
    not ticket.active ? "" : positionSize != ticket.positionAtArm ? "Position changed" : harvesting ? "Harvest" : bar >= ticket.expiryBar ? "Expired" : cancelOpposite and oppositeApproval ? "Opposite approval" : cancelZone and not zoneValid ? "FVG replaced or invalidated" : ""

EP_LimitOrders_canArm(EP_LimitOrders_Ticket ticket, int bar, bool confirmed, bool fillPass) =>
    not ticket.active and confirmed and not fillPass and (na(ticket.eventBar) or bar > ticket.eventBar)

EP_LimitOrders_arm(EP_LimitOrders_Ticket ticket, bool isLong, string kind, float price, float quantity, float positionSize, int zoneBar, int bar, int stamp, int lifetime) =>
    ticket.serial += 1
    ticket.active := true
    ticket.id := "LIMIT_" + (kind == "RESCUE" ? "RESCUE_" : "") + (isLong ? "LONG_" : "SHORT_") + str.tostring(ticket.serial)
    ticket.kind := kind
    ticket.isLong := isLong
    ticket.price := price
    ticket.quantity := quantity
    ticket.positionAtArm := positionSize
    ticket.zoneAtArm := zoneBar
    ticket.bornBar := bar
    ticket.expiryBar := bar + math.max(lifetime, 1)
    ticket.eventSerial += 1
    ticket.eventBar := bar
    ticket.eventTime := stamp
    ticket.event := "PLACED"
    ticket.reason := "Resting limit submitted"
    ticket.eventPrice := price
    ticket

// Only broker-emulator fill records may call finish(..., "FILLED", ...).
EP_LimitOrders_finish(EP_LimitOrders_Ticket ticket, string status, string reason, float price, int bar, int stamp) =>
    ticket.active := false
    ticket.eventSerial += 1
    ticket.eventBar := bar
    ticket.eventTime := stamp
    ticket.event := status
    ticket.reason := reason
    ticket.eventPrice := price
    ticket
// END EP_LimitOrders/1

// BEGIN EP_CloudScreen/1
// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0.
// © ClassicPotatoChamberXII
// @description FVG cloud mitigation and screening, independent of order eligibility.
type EP_CloudScreen_Cloud
    bool exists = false
    bool bullish = true
    int born = na
    float top = na
    float bottom = na
    float remainingTop = na
    float remainingBottom = na
    float birthAtr = na
    float birthRvol = na
    bool structureAtBirth = false
    int touchBars = 0
    int lastTouchBar = na
    int lastObservedBar = na
    bool inverted = false
    bool expired = false

EP_CloudScreen_create() =>
    EP_CloudScreen_Cloud.new()

// A new zone takes over only its own side; the other side remains independently tracked.
EP_CloudScreen_observe(
    EP_CloudScreen_Cloud cloud,
    bool bullish,
    int zoneBar,
    float top,
    float bottom,
    float h,
    float l,
    bool inverted,
    bool ageValid,
    int bar,
    float atr,
    float rvol,
    bool structureAligned
) =>
    if not na(zoneBar) and not na(top) and not na(bottom) and top > bottom
        if not cloud.exists or cloud.born != zoneBar
            cloud.exists := true
            cloud.bullish := bullish
            cloud.born := zoneBar
            cloud.top := top
            cloud.bottom := bottom
            cloud.remainingTop := top
            cloud.remainingBottom := bottom
            cloud.birthAtr := atr
            cloud.birthRvol := rvol
            cloud.structureAtBirth := structureAligned
            cloud.touchBars := 0
            cloud.lastTouchBar := na
            cloud.lastObservedBar := na
        // Skip the formation bar. Updates are idempotent across fill recalculations.
        if bar > cloud.born and ageValid and not cloud.inverted
            bool touched = h >= bottom and l <= top
            if touched and (na(cloud.lastTouchBar) or cloud.lastTouchBar != bar)
                cloud.touchBars += 1
                cloud.lastTouchBar := bar
            if bullish
                cloud.remainingTop := math.max(bottom, math.min(cloud.remainingTop, l))
            else
                cloud.remainingBottom := math.min(top, math.max(cloud.remainingBottom, h))
        cloud.inverted := inverted
        cloud.expired := not ageValid
        cloud.lastObservedBar := bar
    cloud

EP_CloudScreen_remaining(EP_CloudScreen_Cloud cloud) =>
    cloud.exists ? math.max(0.0, math.min(1.0, (cloud.remainingTop - cloud.remainingBottom) / (cloud.top - cloud.bottom))) : na

EP_CloudScreen_distanceAtr(EP_CloudScreen_Cloud cloud, float price, float atr) =>
    cloud.exists and not na(atr) and atr > 0.0 ? math.max(math.max(cloud.bottom - price, price - cloud.top), 0.0) / atr : na

EP_CloudScreen_widthAtr(EP_CloudScreen_Cloud cloud) =>
    cloud.exists and cloud.birthAtr > 0.0 ? (cloud.top - cloud.bottom) / cloud.birthAtr : na

EP_CloudScreen_stateName(EP_CloudScreen_Cloud cloud) =>
    not cloud.exists ? "NONE" : cloud.expired ? "EXPIRED" : cloud.inverted ? "INVERTED" : EP_CloudScreen_remaining(cloud) <= 0.0 ? "MITIGATED" : EP_CloudScreen_remaining(cloud) < 1.0 ? "PARTIAL" : "FRESH"

// This is a transparent geometric/context filter, not a probability or liquidity estimate.
EP_CloudScreen_rejection(
    EP_CloudScreen_Cloud cloud,
    float price,
    float atr,
    float minimumRemaining,
    float minimumWidth,
    float minimumRvol,
    float maximumDistance,
    bool requireStructure,
    bool allowInverted
) =>
    string reason = "PASS"
    if not cloud.exists
        reason := "NO ZONE"
    else if cloud.expired
        reason := "AGE"
    else if cloud.inverted and not allowInverted
        reason := "INVERTED"
    else if not cloud.inverted and EP_CloudScreen_remaining(cloud) <= 0.0
        reason := "MITIGATED"
    else if not cloud.inverted and EP_CloudScreen_remaining(cloud) * 100.0 < minimumRemaining
        reason := "REMAINING"
    else if minimumWidth > 0.0 and (na(EP_CloudScreen_widthAtr(cloud)) or EP_CloudScreen_widthAtr(cloud) < minimumWidth)
        reason := "WIDTH"
    else if minimumRvol > 0.0 and (na(cloud.birthRvol) or cloud.birthRvol < minimumRvol)
        reason := "RVOL"
    else if maximumDistance > 0.0 and (na(EP_CloudScreen_distanceAtr(cloud, price, atr)) or EP_CloudScreen_distanceAtr(cloud, price, atr) > maximumDistance)
        reason := "DISTANCE"
    else if requireStructure and not cloud.structureAtBirth
        reason := "STRUCTURE"
    reason

EP_CloudScreen_opacity(EP_CloudScreen_Cloud cloud, int strongest, int faintest) =>
    float density = cloud.inverted ? 0.5 : nz(EP_CloudScreen_remaining(cloud), 0.0)
    int alpha = int(math.round(faintest + (strongest - faintest) * density))
    math.max(0, math.min(100, alpha))
// END EP_CloudScreen/1

const string G_BASIS = "01 | Instrument basis"
int atrLength = input.int(14, "ATR length", minval=2, group=G_BASIS)
int momentumLength = input.int(14, "Momentum horizon", minval=2, group=G_BASIS)
float kineticScale = input.float(2.5, "Kinetic saturation", minval=0.1, step=0.1, group=G_BASIS)
int pivotLeft = input.int(5, "Pivot left", minval=1, group=G_BASIS)
int pivotRight = input.int(5, "Pivot right", minval=1, group=G_BASIS)

const string G_STRUCTURE = "02 | FVG and structure"
float minimumFvgAtr = input.float(0.15, "Minimum FVG (ATR)", minval=0.0, step=0.05, group=G_STRUCTURE)
int zoneLifetime = input.int(80, "Zone lifetime (bars)", minval=1, maxval=500, group=G_STRUCTURE)
int structureWindow = input.int(12, "Structure gate window", minval=1, maxval=100, group=G_STRUCTURE)
float chochAtr = input.float(0.25, "CHoCH displacement (ATR)", minval=0.0, step=0.05, group=G_STRUCTURE)

const string G_CONTEXT = "03 | Clouds, waves and reversion"
int tenkanLength = input.int(9, "Classical Tenkan", minval=1, group=G_CONTEXT)
int kijunLength = input.int(26, "Classical Kijun", minval=1, group=G_CONTEXT)
int spanBLength = input.int(52, "Classical Span B", minval=2, group=G_CONTEXT)
