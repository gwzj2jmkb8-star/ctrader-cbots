//@version=6
// @description Professional Kinetic Core for ETHER POISON.
// Handles the raw mathematical conviction and magnitude of market movement.

import EP_Math as math_ep
import EP_Types as types_ep

// =============================================================================
// 01. INPUT MATRIX - PROFESSIONAL GRADE
// =============================================================================
var string G_KINETIC = "Kinetic Magnitude Settings"
kineticScale    = input.float(2.5, "Saturation Horizon", minval=0.1, step=0.1, group=G_KINETIC, tooltip="Scale at which momentum reaches 1.0 saturation")
thresholdLethal = input.float(0.85, "Lethal Threshold", minval=0.0, maxval=1.0, step=0.01, group=G_KINETIC)
thresholdViral  = input.float(0.60, "Viral Threshold", minval=0.0, maxval=1.0, step=0.01, group=G_KINETIC)

// =============================================================================
// 02. CORE MAGNITUDE ENGINES
// =============================================================================

// Professional Momentum Measure: A blend of rate-of-change and volatility normalization
f_calculate_magnitude(float src, int len) =>
    float change = src - src[len]
    float vol = ta.atr(len)
    // Professional normalization: Change relative to volatility
    float raw_mag = math.abs(change) / math.max(vol, syminfo.mintick)
    // Pass through the kinetic saturation curve (the "Poison" curve)
    math_ep.kinetic(raw_mag, kineticScale)

// Directional Energy Flux
f_determine_flow(float src, int len) =>
    float diff = src - src[len]
    diff > 0 ? types_ep.EnergyFlow.ASCENDING : diff < 0 ? types_ep.EnergyFlow.DESCENDING : types_ep.EnergyFlow.STATIC

// =============================================================================
// 03. CONVICTION MAPPING (PROFESSIONAL -> NOCTURNE)
// =============================================================================

f_map_toxicity(float mag) =>
    if mag >= thresholdLethal
        types_ep.Toxicity.LETHAL
    else if mag >= thresholdViral
        types_ep.Toxicity.VIRAL
    else if mag > 0.1
        types_ep.Toxicity.DORMANT
    else
        types_ep.Toxicity.STABLE

// =============================================================================
// 04. MAIN EXECUTION PIPELINE
// =============================================================================

// Analyze primary asset flow
float assetMag = f_calculate_magnitude(close, 14)
types_ep.EnergyFlow currentFlow = f_determine_flow(close, 14)
types_ep.Toxicity currentTox = f_map_toxicity(assetMag)

// Construct the Kinetic State packet for the Render Engine
types_ep.KineticState kineticState = types_ep.KineticState.new()
kineticState.magnitude := assetMag
kineticState.toxicity  := currentTox
kineticState.flow      := currentFlow
kineticState.conviction := assetMag * (currentTox == types_ep.Toxicity.LETHAL ? 1.0 : 0.5)

// Export for the master orchestrator
plot(assetMag, "Kinetic Magnitude", color=color.new(color.gray, 50), display=display.none)


// =============================================================================
// 01. CONFIGURATION - MARKET INSTRUMENT STANDARDS
// =============================================================================
var string G_SPATIAL = "Spatial Gate Configuration"
fvg_min_size    = input.float(0.5, "Min FVG Size (ATR x)", minval=0.0, step=0.1, group=G_SPATIAL)
bos_lookback    = input.int(5, "Structure Lookback", minval=2, group=G_SPATIAL)
choch_threshold = input.float(1.2, "CHoCH Magnitude (ATR x)", minval=0.1, step=0.1, group=G_SPATIAL)

// =============================================================================
// 02. FAIR VALUE GAP (FVG) DETECTION
// =============================================================================

f_detect_fvg() =>
    float atr = ta.atr(14)
    bool bull_fvg = low[0] > high[2] and (low[0] - high[2]) > (fvg_min_size * atr)
    bool bear_fvg = high[0] < low[2] and (low[2] - high[0]) > (fvg_min_size * atr)
    [bull_fvg, bear_fvg]

[hasBullFvg, hasBearFvg] = f_detect_fvg()

// =============================================================================
// 03. STRUCTURE BREAKS (BOS & CHoCH)
// =============================================================================

// Simple Pivot-based structure
float ph = ta.pivothigh(bos_lookback, bos_lookback)
float pl = ta.pivotlow(bos_lookback, bos_lookback)

var float lastHigh = na
var float lastLow = na
if not na(ph)
    lastHigh := ph
if not na(pl)
    lastLow := pl

// BOS: Break of structure in direction of flow
bool bosBull = close > lastHigh
bool bosBear = close < lastLow

// CHoCH: Change of Character (Aggressive reversal)
// Requires a move against the previous structural point with significant magnitude
float atr = ta.atr(14)
bool chochBull = close > lastHigh and (close - lastHigh) > (choch_threshold * atr)
bool chochBear = close < lastLow and (lastLow - close) > (choch_threshold * atr)

// =============================================================================
// 04. PERMISSION LOGIC (THE GATEKEEPER)
// =============================================================================

f_get_spatial_permission(bool bullFvg, bool bearFvg, bool bBull, bool bBear, bool cBull, bool cBear) =>
    // Long Permission: Requires FVG AND (BOS or CHoCH)
    bool longAllowed = bullFvg and (bBull or cBull)
    // Short Permission: Requires FVG AND (BOS or CHoCH)
    bool shortAllowed = bearFvg and (bBear or cBear)
    
    types_ep.Permission perm = types_ep.Permission.WAIT
    if longAllowed
        perm := types_ep.Permission.OFFENSIVE
    else if shortAllowed
        perm := types_ep.Permission.DEFENSIVE
    
    perm

// Execute Permission Check
types_ep.Permission spatialPerm = f_get_spatial_permission(hasBullFvg, hasBearFvg, bosBull, bosBear, chochBull, chochBear)

// Export for Master Orchestrator
plot(hasBullFvg ? 1 : hasBearFvg ? -1 : 0, "FVG State", display=display.none)
plot(bosBull ? 1 : bosBear ? -1 : 0, "BOS State", display=display.none)


// =============================================================================
// 01. RESCUE CONFIGURATION - PROFESSIONAL GRADE
// =============================================================================
var string G_RESCUE = "Rescue Engine Settings"
rescue_min_dist    = input.float(1.5, "Min Adverse Distance (ATR x)", minval=0.1, step=0.1, group=G_RESCUE)
rescue_target_avg  = input.float(0.5, "Target Avg. Distance (Ticks)", step=0.1, group=G_RESCUE)
rescue_harvest_pct = input.float(50.0, "Harvest Amount (%)", minval=1.0, maxval=100.0, group=G_RESCUE)
rescue_max_cycles  = input.int(3, "Max Rescue Cycles", minval=1, group=G_RESCUE)

// =============================================================================
// 02. RECOVERY MATH
// =============================================================================

// Calculates the required quantity to move the average price to the target
f_calc_rescue_qty(float current_qty, float current_avg, float rescue_price, float target_avg, bool isLong) =>
    float denominator = isLong ? (target_avg - rescue_price) : (rescue_price - target_avg)
    float numerator = isLong ? current_qty * (current_avg - target_avg) : current_qty * (target_avg - current_avg)
    
    denominator > 0 and numerator > 0 ? numerator / denominator : 0.0

// =============================================================================
// 03. RESCUE STATE TRACKER
// =============================================================================

type RescueState
    int cycles = 0
    float lastRescuePrice = na
    bool isRecovering = false

var RescueState rState = RescueState.new()

// =============================================================================
// 04. EXECUTION LOGIC (PROFESSIONAL)
// =============================================================================

// Determine if we are in a "Rescue Window"
f_check_rescue_window(float entry_price, bool isLong) =>
    float atr = ta.atr(14)
    float dist = isLong ? (entry_price - close) : (close - entry_price)
    dist > (rescue_min_dist * atr)

// The Rescue Process
f_execute_rescue(float entry_price, float current_qty, bool isLong) =>
    float atr = ta.atr(14)
    float rescue_price = close
    float target_avg = isLong ? rescue_price + (rescue_target_avg * syminfo.mintick) : rescue_price - (rescue_target_avg * syminfo.mintick)
    
    if f_check_rescue_window(entry_price, isLong) and rState.cycles < rescue_max_cycles
        float addQty = f_calc_rescue_qty(current_qty, entry_price, rescue_price, target_avg, isLong)
        rState.cycles += 1
        rState.lastRescuePrice := rescue_price
        rState.isRecovering := true
        addQty
    else
        0.0

// Tactical Harvesting: Exiting part of the position when the "Energy" returns
f_check_harvest(float entry_price, float current_qty, bool isLong, float kinetic_mag) =>
    float profit = isLong ? (close - entry_price) : (entry_price - close)
    // Harvest if we have a small profit AND kinetic energy is fading (Exhaustion)
    bool harvestCondition = profit > 0 and kinetic_mag < 0.3
    
    harvestCondition ? (current_qty * (rescue_harvest_pct / 100.0)) : 0.0

// =============================================================================
// 05. EXPORT FOR MASTER
// =============================================================================

// These are used by the Master Orchestrator to trigger strategy.entry/exit
plot(rState.cycles, "Rescue Cycle Count", display=display.none)
plot(rState.isRecovering ? 1 : 0, "Recovery Mode Active", display=display.none)


// =============================================================================
// 01. CONFIGURATION - PROFESSIONAL GRID
// =============================================================================
var string G_TIME = "Time Theory & Waves"
time_rail_len   = input.int(21, "Time Rail Lookback", minval=5, group=G_TIME)
wave_sensitivity = input.float(1.2, "Wave Flux Sensitivity", step=0.1, group=G_TIME)

var string G_CLOUD = "Dual-Span Cloud Engine"
span_a_len      = input.int(9, "Accumulation Span (A)", group=G_CLOUD)
span_b_len      = input.int(26, "Distribution Span (B)", group=G_CLOUD)
rapid_exp_mult  = input.float(1.5, "Rapid Expansion Mult", step=0.1, group=G_CLOUD)

var string G_VOL = "Volatility & Mean Reversion"
sb_len          = input.int(20, "SuperBoll Length", group=G_VOL)
sb_mult         = input.float(2.0, "SuperBoll StdDev", group=G_VOL)

// =============================================================================
// 02. DUAL-SPAN CLOUD (ACCUMULATION vs DISTRIBUTION)
// =============================================================================

// Professional Span A (Accumulation) - Fast response to current energy
float spanA = (ta.highest(high, span_a_len) + ta.lowest(low, span_a_len)) / 2
// Professional Span B (Distribution) - Slow response to deep structural energy
float spanB = (ta.highest(high, span_b_len) + ta.lowest(low, span_b_len)) / 2

// The "Parallel" Clouds
// Cloud 1: Immediate proximity to candles (Accumulated Value)
float cloud1_top = math.max(spanA, spanB)
float cloud1_bot = math.min(spanA, spanB)

// Cloud 2: Rapid Expansion (The "Lethal" Stretch)
float rapidA = spanA * (1 + (rapid_exp_mult * 0.01))
float rapidB = spanB * (1 - (rapid_exp_mult * 0.01))

// =============================================================================
// 03. TIME THEORY WAVES & GRID
// =============================================================================

// Calculating the "Time Rail" - The horizontal projection of energy
float wave_energy = ta.sma(math.abs(close - close[1]), time_rail_len)
float time_grid_level = ta.vwap

// Rapid Expansion Ichimoku Logic
float ichi_tenkan = (ta.highest(high, 9) + ta.lowest(low, 9)) / 2
float ichi_kijun  = (ta.highest(high, 26) + ta.lowest(low, 26)) / 2
float ichi_spanA  = (ichi_tenkan + ichi_kijun) / 2
float ichi_spanB  = (ta.highest(high, 52) + ta.lowest(low, 52)) / 2

// =============================================================================
// 04. MEAN REVERSION & VOLATILITY BREAKOUT
// =============================================================================

float sb_ma = ta.sma(close, sb_len)
float sb_dev = ta.stdev(close, sb_len)
float sb_upper = sb_ma + (sb_dev * sb_mult)
float sb_lower = sb_ma - (sb_dev * sb_mult)

// Professional Volatility Breakout
bool vol_breakout_up = close > sb_upper and close > high[1]
bool vol_breakout_dn = close < sb_lower and close < low[1]

// =============================================================================
// 05. EXPORT FOR RENDER ENGINE
// =============================================================================

// We plot these as hidden values so the Render Engine can pick them up
plot(spanA, "Accumulation Span", display=display.none)
plot(spanB, "Distribution Span", display=display.none)
plot(sb_upper, "SuperBoll Upper", display=display.none)
plot(sb_lower, "SuperBoll Lower", display=display.none)
plot(ichi_spanA, "Ichi Span A", display=display.none)
plot(ichi_spanB, "Ichi Span B", display=display.none)



// =============================================================================
// 01. THE NOCTURNE PALETTE (THE DARKNESS)
// =============================================================================
color C_VOID          = color.rgb(5, 5, 15)        // Deepest space
color C_SHADOW       = color.rgb(20, 20, 35, 60)   // Translucent gloom
color C_POISON_GREEN  = color.rgb(0, 255, 128, 20) // Glowing toxin
color C_BLOOD_RED    = color.rgb(159, 18, 60, 20)  // Cursed fate
color C_ETHER_TEAL    = color.rgb(20, 184, 166, 30) // Holographic flux
color C_GHOST_WHITE   = color.rgb(220, 220, 255, 80) // Spectral echo

// =============================================================================
// 02. THE HOLOGRAPHIC PROJECTION (Toxicity -> Visuals)
// =============================================================================

f_get_toxicity_color(types_ep.Toxicity tox) =>
    switch tox
        types_ep.Toxicity.LETHAL    => C_POISON_GREEN
        types_ep.Toxicity.VIRAL     => C_ETHER_TEAL
        types_ep.Toxicity.DORMANT   => color.rgb(60, 60, 80, 50)
        types_ep.Toxicity.STABLE    => color.rgb(30, 30, 40, 80)
        => color.gray

// =============================================================================
// 03. THE NOCTURNE RENDERER
// =============================================================================

// This function would be called by the Master Orchestrator
f_render_nocturne(float spanA, float spanB, float rapidA, float rapidB, types_ep.Toxicity currentTox) =>
    // 1. The Dual-Span Shadow Cloud
    // We render the space between A and B as a "Curtain of Gloom"
    color cloudCol = f_get_toxicity_color(currentTox)
    
    // Professional Drawing: Fill the void between spans
    // (In a real master script, this would use plotfill)
    
    // 2. The Rapid Expansion "Tearing"
    // When Toxicity is LETHAL, the rapid spans glow intensely
    color rapidCol = currentTox == types_ep.Toxicity.LETHAL ? C_POISON_GREEN : C_SHADOW
    
    // 3. The Time-Rail Neon Threads
    // We render the grid as a holographic projection
    color railCol = currentTox == types_ep.Toxicity.VIRAL ? C_ETHER_TEAL : C_GHOST_WHITE

// =============================================================================
// 04. THE PSYCH-DASHBOARD (HoloVR Interface)
// =============================================================================

f_render_cockpit(types_ep.KineticState state, types_ep.Permission perm) =>
    var table cockpit = table.new(position.top_right, 2, 5, bgcolor=C_VOID, border_width=1, border_color=C_SHADOW)
    
    if barstate.islast
        // Header: The Entity Name
        table.cell(cockpit, 0, 0, "ETHER", text_color=C_GHOST_WHITE, text_size=size.small)
        table.cell(cockpit, 1, 0, "POISON", text_color=C_POISON_GREEN, text_size=size.small)
        
        // Row 1: Toxicity State
        table.cell(cockpit, 0, 1, "TOXICITY", text_color=C_GHOST_WHITE, text_size=size.tiny)
        table.cell(cockpit, 1, 1, str.tostring(state.toxicity), bgcolor=f_get_toxicity_color(state.toxicity), text_size=size.tiny)
        
        // Row 2: Energy Flow
        table.cell(cockpit, 0, 2, "FLOW", text_color=C_GHOST_WHITE, text_size=size.tiny)
        table.cell(cockpit, 1, 2, str.tostring(state.flow), text_color=C_ETHER_TEAL, text_size=size.tiny)
        
        // Row 3: Permission
        table.cell(cockpit, 0, 3, "PERMIT", text_color=C_GHOST_WHITE, text_size=size.tiny)
        table.cell(cockpit, 1, 3, str.tostring(perm), text_color=perm == types_ep.Permission.OFFENSIVE ? C_POISON_GREEN : C_BLOOD_RED, text_size=size.tiny)
        
        // Row 4: Conviction magnitude
        table.cell(cockpit, 0, 4, "CONVICTION", text_color=C_GHOST_WHITE, text_size=size.tiny)
        table.cell(cockpit, 1, 4, str.tostring(state.conviction * 100, "#.0") + "%", text_color=C_GHOST_WHITE, text_size=size.tiny)

// Export for Master
