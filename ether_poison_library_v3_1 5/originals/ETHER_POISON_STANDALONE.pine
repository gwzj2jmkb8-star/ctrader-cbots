strategy("ETHER | Spatial Energy Matrix v2", overlay=true, initial_capital=10000,
     default_qty_type=strategy.percent_of_equity, default_qty_value=10,
     pyramiding=10, commission_type=strategy.commission.percent,
     commission_value=0.04, slippage=1, process_orders_on_close=true,
     calc_on_order_fills=true, max_lines_count=160, max_boxes_count=80,
     max_labels_count=160)

// Publish in order: Math/2, Types/2, Engines/2, Nocturne/1. If TradingView
// assigns different versions, change only the matching import suffixes below.

enum Direction
    LONG = "LONG"
    SHORT = "SHORT"
    WAIT = "WAIT"

enum EntropyState
    ORDERED = "ORDERED"
    MIXED = "MIXED"
    DIFFUSE = "DIFFUSE"
    CHAOTIC = "CHAOTIC"

enum CloudLane
    FAST = "FAST"
    BALANCED = "BALANCED"
    SLOW = "SLOW"

type CloudState
    float spanA = na
    float spanB = na
    float center = na
    float widthAtr = 0.0
    float direction = 0.0
    float entropyFast = 1.0
    float entropyMedium = 1.0
    float entropySlow = 1.0
    float entropyComposite = 1.0
    float tempAtten = 0.0
    float densityFast = 0.0
    float densityMedium = 0.0
    float densitySlow = 0.0
    float agreement = 0.0
    float confidence = 0.0
    EntropyState entropyState = EntropyState.CHAOTIC
    CloudLane dominantLane = CloudLane.BALANCED
    bool valid = false

fEntropyName(EntropyState state) =>
    state == EntropyState.ORDERED ? "ORDERED" : state == EntropyState.MIXED ? "MIXED" : state == EntropyState.DIFFUSE ? "DIFFUSE" : "CHAOTIC"

fLaneName(CloudLane lane) =>
    lane == CloudLane.FAST ? "FAST" : lane == CloudLane.SLOW ? "SLOW" : "BALANCED"

fClamp(float value, float low, float high) =>
    math.max(low, math.min(high, value))

fWeightedMean(float numerator, float denominator) =>
    denominator > 0.0 ? numerator / denominator : 0.0

fNorm(float value, float scale) =>
    fClamp(value / math.max(math.abs(scale), 1e-6), -1.0, 1.0)

fBlend3(float a, float wa, float b, float wb, float c, float wc) =>
    float weightA = math.max(wa, 0.0)
    float weightB = math.max(wb, 0.0)
    float weightC = math.max(wc, 0.0)
    fWeightedMean(a * weightA + b * weightB + c * weightC, weightA + weightB + weightC)

fBinaryEntropy(float probability) =>
    float p = fClamp(probability, 1e-6, 1.0 - 1e-6)
    -(p * math.log(p) + (1.0 - p) * math.log(1.0 - p)) / math.log(2.0)

fTempAtten(float entropy, float temperature, float floorValue) =>
    fClamp(math.exp(-math.max(temperature, 0.0) * fClamp(entropy, 0.0, 1.0)), fClamp(floorValue, 0.0, 1.0), 1.0)

fAgreement(float a, float b, float c) =>
    fClamp(1.0 - (math.abs(a - b) + math.abs(b - c) + math.abs(a - c)) / 3.0, 0.0, 1.0)

fCloudConfidence(float direction, float agreementValue, float inverseEntropy) =>
    fClamp(math.abs(direction) * 0.45 + agreementValue * 0.30 + inverseEntropy * 0.25, 0.0, 1.0)

fMidpoint(float highValue, float lowValue) =>
    (highValue + lowValue) * 0.5

fKineticMagnitude(float source, float sourcePast, float atrValue, float scale) =>
    float raw = math.abs(source - sourcePast) / math.max(atrValue, 1e-6)
    float bounded = math.min(raw / math.max(scale, 1e-6), 1.0)
    math.min(math.tan(bounded * math.pi / 4.0), 1.0)

fZScore(float source, simple int length) =>
    float basis = ta.sma(source, length)
    float deviation = ta.stdev(source, length)
    deviation > 0.0 ? (source - basis) / deviation : 0.0

fRescueQuantity(float currentQuantity, float currentAverage, float rescuePrice, float targetAverage, bool isLong, float maximumMultiple) =>
    float denominator = isLong ? targetAverage - rescuePrice : rescuePrice - targetAverage
    float numerator = isLong ? currentQuantity * (currentAverage - targetAverage) : currentQuantity * (targetAverage - currentAverage)
    float rawQuantity = denominator > 0.0 and numerator > 0.0 ? numerator / denominator : 0.0
    math.min(rawQuantity, currentQuantity * math.max(maximumMultiple, 0.0))

fMultiplexerCloud(float source, float atrValue, simple int fastLength, simple int mediumLength, simple int slowLength, float temperature, float attenuationFloor, float contourAtr) =>
    int fastN = math.max(fastLength, 2)
    int mediumN = math.max(mediumLength, fastN + 1)
    int slowN = math.max(slowLength, mediumN + 1)
    float atrSafe = math.max(math.abs(atrValue), 1e-6)
    float returnNorm = fNorm(source - source[1], atrSafe)
    float localEntropy = fBinaryEntropy(fClamp(0.5 + returnNorm * 0.5, 1e-6, 1.0 - 1e-6))
    float entropyFast = ta.ema(localEntropy, fastN)
    float entropyMedium = ta.ema(localEntropy, mediumN)
    float entropySlow = ta.ema(localEntropy, slowN)
    float entropyComposite = fBlend3(entropyFast, 1.0, entropyMedium, 1.0, entropySlow, 1.0)
    float attenuation = fTempAtten(entropyComposite, temperature, attenuationFloor)
    float directionFast = fNorm(ta.ema(source - source[1], fastN), atrSafe)
    float directionMedium = fNorm(ta.ema(source - source[1], mediumN), atrSafe)
    float directionSlow = fNorm(ta.ema(source - source[1], slowN), atrSafe)
    float densityFast = math.max(1.0 - entropyFast, 0.0) * attenuation
    float densityMedium = math.max(1.0 - entropyMedium, 0.0) * attenuation
    float densitySlow = math.max(1.0 - entropySlow, 0.0) * attenuation
    float densityTotal = densityFast + densityMedium + densitySlow
    float centerFast = ta.ema(source, fastN)
    float centerMedium = ta.ema(source, mediumN)
    float centerSlow = ta.ema(source, slowN)
    float center = densityTotal > 0.0 ? fBlend3(centerFast, densityFast, centerMedium, densityMedium, centerSlow, densitySlow) : centerMedium
    float direction = densityTotal > 0.0 ? fBlend3(directionFast, densityFast, directionMedium, densityMedium, directionSlow, densitySlow) : 0.0
    float laneAgreement = fAgreement(directionFast, directionMedium, directionSlow)
    float cloudConfidence = fCloudConfidence(direction, laneAgreement, 1.0 - entropyComposite)
    float widthAtr = math.max(contourAtr, 0.0) * (0.35 + entropyComposite * 0.65) * (0.50 + math.abs(direction) * 0.50) * attenuation
    float directionalShift = direction * atrSafe * widthAtr * 0.35
    float halfWidth = atrSafe * widthAtr
    float spanA = center + directionalShift + halfWidth
    float spanB = center + directionalShift - halfWidth
    EntropyState entropyState = entropyComposite <= 0.25 ? EntropyState.ORDERED : entropyComposite <= 0.50 ? EntropyState.MIXED : entropyComposite <= 0.75 ? EntropyState.DIFFUSE : EntropyState.CHAOTIC
    CloudLane dominantLane = densityFast >= densityMedium and densityFast >= densitySlow ? CloudLane.FAST : densitySlow >= densityFast and densitySlow >= densityMedium ? CloudLane.SLOW : CloudLane.BALANCED
    CloudState.new(spanA, spanB, center, widthAtr, direction, entropyFast, entropyMedium, entropySlow, entropyComposite, attenuation, densityFast, densityMedium, densitySlow, laneAgreement, cloudConfidence, entropyState, dominantLane, not na(spanA) and not na(spanB))

fNocturneClampAlpha(float value) =>
    int(math.round(math.max(0.0, math.min(100.0, value))))

fNocturneDensityAlpha(float confidence, float entropy, float tempAtten, int lightAlpha, int darkAlpha) =>
    float visibility = math.max(0.0, math.min(1.0, confidence * tempAtten * (1.0 - entropy * 0.45)))
    fNocturneClampAlpha(darkAlpha - visibility * math.max(darkAlpha - lightAlpha, 0))

fNocturneDirectionalColor(color bull, color bear, color neutral, float direction, float deadband, int alpha) =>
    color base = direction > deadband ? bull : direction < -deadband ? bear : neutral
    color.new(base, fNocturneClampAlpha(alpha))

fNocturneSpectralColor(color base, float density, int faintAlpha, int strongAlpha) =>
    float boundedDensity = math.max(0.0, math.min(1.0, density))
    color.new(base, fNocturneClampAlpha(faintAlpha - boundedDensity * math.max(faintAlpha - strongAlpha, 0)))

