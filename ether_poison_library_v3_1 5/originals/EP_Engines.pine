library("EP_Engines")

export midpoint(float highValue, float lowValue) =>
    (highValue + lowValue) * 0.5

export kineticMagnitude(float source, float sourcePast, float atr, float scale) =>
    float raw = math.abs(source - sourcePast) / math.max(atr, 1e-6)
    float bounded = math.min(raw / math.max(scale, 1e-6), 1.0)
    math.min(math.tan(bounded * math.pi / 4.0), 1.0)

export zScore(float source, simple int length) =>
    float basis = ta.sma(source, length)
    float deviation = ta.stdev(source, length)
    deviation > 0.0 ? (source - basis) / deviation : 0.0

export normalizeSigned(float value, float scale) =>
    math.max(-1.0, math.min(1.0, value / math.max(math.abs(scale), 1e-6)))

export rescueQuantity(float currentQuantity, float currentAverage, float rescuePrice, float targetAverage, bool isLong, float maximumMultiple) =>
    float denominator = isLong ? targetAverage - rescuePrice : rescuePrice - targetAverage
    float numerator = isLong ? currentQuantity * (currentAverage - targetAverage) : currentQuantity * (targetAverage - currentAverage)
    float rawQuantity = denominator > 0.0 and numerator > 0.0 ? numerator / denominator : 0.0
    math.min(rawQuantity, currentQuantity * math.max(maximumMultiple, 0.0))

